# ไฟล์แนบของผู้ใช้ (รายงานนักเรียน แบบฟอร์ม ภาพแจ้งปัญหา) — ข้อมูลจริง ห้ามขึ้น git
uploads/*
!uploads/.htaccess

# ไฟล์สำรองข้อมูล (มีฐานข้อมูลทั้งหมด รวมชื่อผู้ใช้และรหัสผ่านที่เข้ารหัส)
backups/*
!backups/.htaccess

# สถานะการติดตั้งของแต่ละเครื่อง
install/install.lock

# ไฟล์สำรองที่ทำเองในเครื่อง (อาจมีรหัสผ่านฐานข้อมูลจริง)
*bak*.php
*.bak
*.orig

# ไฟล์ของระบบปฏิบัติการ / editor
Thumbs.db
.DS_Store
desktop.ini
.vscode/
.idea/
*.log

# ค่าตั้งค่าจริงของแต่ละเครื่อง (รหัสผ่านฐานข้อมูล)
config.local.php

# สำเนาไฟล์ตั้งค่าอื่น ๆ (เช่น config2.php) อาจมีรหัสผ่านจริง
config*.php
!config.php
